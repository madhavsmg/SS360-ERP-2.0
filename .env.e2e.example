# Browser target used by local QA Playwright runs.
PLAYWRIGHT_BASE_URL=http://127.0.0.1:5174
PLAYWRIGHT_QA_BASE_URL=http://127.0.0.1:5174

# Deployed targets for release gates.
PLAYWRIGHT_STAGE_BASE_URL=https://staging.example.com
PLAYWRIGHT_PROD_BASE_URL=https://production-test.example.com
PLAYWRIGHT_REAL_PROD_BASE_URL=https://production.example.com

# Backend API target. Keep this pointed at QA/stage/sandbox services for mutating tests.
VITE_API_BASE_URL=http://127.0.0.1:5000
PLAYWRIGHT_API_URL=http://127.0.0.1:5000

# Database reset/seed tooling. Production-test requires a sandbox/test tenant identifier.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/ss360_erp?schema=public
E2E_ENV=qa
E2E_TEST_TENANT_ID=ss360-e2e-sandbox
E2E_REQUIRE_DATABASE=0

# Set to 1 when testing against a deployed URL and Playwright should not start Vite locally.
PLAYWRIGHT_SKIP_WEBSERVER=0
