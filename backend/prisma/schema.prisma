generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum InvoiceStatus {
  UPLOADED
  NEEDS_REVIEW
  APPROVED
  OCR_FAILED
}

model Invoice {
  id               String            @id @default(cuid())
  originalFileName String
  storedFileName   String
  filePath         String
  mimeType         String
  size             Int
  sourceType       String?
  status           InvoiceStatus     @default(UPLOADED)
  rawText          String?
  extractionJson   Json?
  reviewJson       Json?
  approvedJson     Json?
  confidenceScore  Int?
  approvedAt       DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  purchaseOrders   PurchaseOrder[]
  rawLots          RawInventoryLot[]
}

model Supplier {
  id             String            @id @default(cuid())
  name           String            @unique
  gstin          String?
  address        String?
  phone          String?
  outstanding    Float             @default(0)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  purchaseOrders PurchaseOrder[]
  rawLots        RawInventoryLot[]
}

model PurchaseOrder {
  id               String   @id
  invoiceId        String
  supplierId       String
  supplierName     String
  invoiceNumber    String
  variety          String
  grade            String
  orderBags        Float
  bagWeightKg      Float
  ratePerKg        Float
  orderedKg        Float
  receivedKg       Float
  expectedDate     DateTime
  status           String
  goodsAmount      Float
  allocatedCharges Float
  landedCostPerKg  Float
  totalCost        Float
  paidAmount       Float    @default(0)
  sampleJson       Json?
  createdAt        DateTime @default(now())
  invoice          Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  supplier         Supplier @relation(fields: [supplierId], references: [id])
}

model RawInventoryLot {
  id                     String   @id
  invoiceId              String
  purchaseOrderId        String
  supplierId             String
  supplierName           String
  variety                String
  grade                  String
  bags                   Float
  bagWeightKg            Float
  receivedKg             Float
  remainingKg            Float
  costPerKg              Float
  goodsRatePerKg         Float
  goodsAmount            Float
  acquisitionChargeShare Float
  landedCost             Float
  reorderKg              Float
  receivedDate           DateTime
  qualityJson            Json?
  movementsJson          Json?
  createdAt              DateTime @default(now())
  invoice                Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  supplier               Supplier @relation(fields: [supplierId], references: [id])
}
