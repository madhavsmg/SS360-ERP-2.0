{
  "name": "ss360-erp-2.0",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:local": "vite --host 127.0.0.1 --port 5174",
    "build": "vite build",
    "lint": "eslint .",
    "lint:strict": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "vite preview",
    "scan:invoices": "node scripts/extract-samples.js",
    "verify:sales": "node scripts/verify-sales-calculations.js",
    "verify:shared": "node scripts/verify-shared-helpers.js",
    "syntax:backend": "node scripts/check-js-syntax.js backend/src backend/prisma scripts",
    "ocr:check": "node scripts/check-ocr-python.js",
    "check": "npm run lint:strict && npm run verify:sales && npm run verify:shared && npm run scan:invoices && npm run build && npm audit --audit-level=moderate && npm --prefix backend run check && npm run ocr:check",
    "check:full": "npm run check && npm run test:e2e:qa -- --grep-invert @destructive",
    "system:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-ss360.ps1",
    "system:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/stop-ss360.ps1",
    "test:e2e": "playwright test --headed --workers=1",
    "test:e2e:qa": "playwright test --project=qa-chromium --headed --workers=1",
    "test:e2e:stage": "playwright test --project=staging-chromium --headed --workers=1",
    "test:e2e:prod": "playwright test --project=production-test-chromium --headed --workers=1",
    "test:e2e:ci": "playwright test",
    "test:e2e:qa:ci": "playwright test --project=qa-chromium",
    "test:e2e:stage:ci": "playwright test --project=staging-chromium",
    "test:e2e:prod:ci": "playwright test --project=production-test-chromium",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "e2e:reset": "node scripts/e2e-reset.mjs",
    "e2e:seed": "node scripts/e2e-seed.mjs"
  },
  "dependencies": {
    "html5-qrcode": "^2.3.8",
    "lucide-react": "^1.14.0",
    "pdfjs-dist": "^4.10.38",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.5.1",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@babel/eslint-parser": "^7.27.0",
    "@playwright/test": "^1.55.0",
    "@vitejs/plugin-react-swc": "^4.3.1",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "pdf-parse": "^2.4.5",
    "prettier": "^3.5.3",
    "vite": "^8.0.16"
  }
}
